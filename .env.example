# ==================================================================
# Agora AI Agent -- Environment Configuration
#
# This is a TEMPLATE. Copy it to create your environment files:
#
#   cp .env.example .env.dev    (for local development)
#   cp .env.example .env.prod   (for production on OVH)
#
# Usage:
#   Development:  docker compose up
#   Production:   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# NEVER commit .env.dev or .env.prod -- they contain secrets.
# ==================================================================

# ------------------------------------------------------------------
# General
# ------------------------------------------------------------------
# PROJECT_NAME=Agora AI Agent
# AGORA_ENV=development
# API_V1_STR=/api/v1
# DEBUG=false
# TRUSTED_PROXY_HOST=*

# ------------------------------------------------------------------
# CORS (comma-separated origins)
# ------------------------------------------------------------------
# CORS_ORIGINS=http://localhost:4200,http://localhost:80,http://localhost

# ------------------------------------------------------------------
# Logging (infrastructure)
# ------------------------------------------------------------------
# LOG_DIR=/tmp/logs
# LOG_MAX_BYTES=10485760
# LOG_BACKUP_COUNT=5

# ------------------------------------------------------------------
# Database (PostgreSQL + PGVector)
# ------------------------------------------------------------------
POSTGRES_USER=agora
POSTGRES_PASSWORD=agora_password
POSTGRES_DB=agora_db
# POSTGRES_HOST=db
# POSTGRES_PORT=5432
# SQL_ECHO=false

# ------------------------------------------------------------------
# Redis
# ------------------------------------------------------------------
# REDIS_HOST=redis
# REDIS_PORT=6379

# ------------------------------------------------------------------
# Session / Auth
# ------------------------------------------------------------------
# SESSION_COOKIE_NAME=agora_session_id
# SESSION_TTL_SECONDS=86400
# OAUTH_STATE_TTL_SECONDS=600
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_SAMESITE=lax

# ------------------------------------------------------------------
# Platon API
# ------------------------------------------------------------------
# PLATON_BASE_URL=https://platon.univ-eiffel.fr/api/v1
# PLATON_PLAYER_URL=https://platon.univ-eiffel.fr/player/preview
# PLATON_LOGIN_BASE_URL=https://platon.univ-eiffel.fr/login
# PLATON_CALLBACK_URL=http://localhost:80/auth/callback
# PLATON_CALLBACK_TITLE=Agora AI Agent
# PLATON_TIMEOUT_SECONDS=30.0
# PLATON_API_TOKEN=
# PLATON_PUBLIC_KEY=
# TEMP_PLATON_API_TOKEN=
# PLATON_ADMIN_USERNAME=
# PLATON_ADMIN_PASSWORD=

# ------------------------------------------------------------------
# Embedding / RAG
# ------------------------------------------------------------------
# RAG_TABLE_NAME=agora_rag_embeddings
# PLATON_DOCS_VECTOR_TABLE=platon_docs_fr_chunks
# PLATON_DOCS_QA_ENABLED=true

# ------------------------------------------------------------------
# Generation / Tuning
#
# The following parameters are managed at runtime through the admin
# panel (Configuration tab) and persisted in the database:
#
#   TEMP_GENERATION, NUM_EXAMPLE_EXERCISES, RAG_LOG_TOP_K,
#   PLATON_DOCS_TOP_K, RERANK_TOP_N, SANDBOX_RETRY_MAX_ATTEMPTS,
#   SANDBOX_RETRY_TIMEOUT_SECONDS, FILE_UPLOAD_MAX_COUNT, LOG_LEVEL
#
# Code-level defaults live in SETTINGS_REGISTRY
# (runtime_config_service.py) and seed the database on first startup.
# You may still set them here to override the initial seed value, but
# subsequent changes should be made via the admin UI.
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# LLM Providers
#
# Provider configuration lives in resources/llm_providers.json.
# The entry with "default": true is the system-wide active provider.
# API keys use ${VAR_NAME} placeholders in the JSON file, resolved
# from the environment variables below.
#
# Supported kinds: openai_compatible, ragustave, gemini, ollama, openrouter, cerebras
# ------------------------------------------------------------------
# LLM_PROVIDERS_FILE=resources/llm_providers.json
# GROQ_API_KEY=your_groq_api_key_here
# RAGUSTAVE_API_KEY=your_ragustave_api_key_here


