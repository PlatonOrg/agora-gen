# ==================================================================
# Agora AI Agent -- Production Environment Template
# Copy to .env.prod and fill in ALL values before deploying.
# NEVER commit .env.prod to version control.
# ==================================================================

# ------------------------------------------------------------------
# General
# ------------------------------------------------------------------
PROJECT_NAME=Agora AI Agent
AGORA_ENV=production
API_V1_STR=/api/v1
DEBUG=false
TRUSTED_PROXY_HOST=127.0.0.1

# ------------------------------------------------------------------
# CORS — set to your actual production domain(s)
# ------------------------------------------------------------------
CORS_ORIGINS=https://your-domain.example.com

# ------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------
LOG_LEVEL=WARNING
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# ------------------------------------------------------------------
# Database (PostgreSQL + PGVector)
# REQUIRED — no defaults accepted in production
# ------------------------------------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=agora_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
SQL_ECHO=false

# ------------------------------------------------------------------
# Redis
# REQUIRED — must match the password passed to redis-server
# ------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------
# Session / Auth
# ------------------------------------------------------------------
SESSION_COOKIE_NAME=agora_session_id
SESSION_TTL_SECONDS=86400
OAUTH_STATE_TTL_SECONDS=600
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=strict

# ------------------------------------------------------------------
# Platon API
# ------------------------------------------------------------------
PLATON_BASE_URL=https://platon.univ-eiffel.fr/api/v1
PLATON_PLAYER_URL=https://platon.univ-eiffel.fr/player/preview
PLATON_LOGIN_BASE_URL=https://platon.univ-eiffel.fr/login
PLATON_CALLBACK_URL=https://your-domain.example.com/auth/callback
PLATON_CALLBACK_TITLE=Agora AI Agent
PLATON_TIMEOUT_SECONDS=30.0
PLATON_API_TOKEN=
PLATON_PUBLIC_KEY=
PLATON_ADMIN_USERNAME=
PLATON_ADMIN_PASSWORD=

# ------------------------------------------------------------------
# Embedding / RAG
# ------------------------------------------------------------------
EMBED_MODEL_HF_REPO_ID=intfloat/multilingual-e5-large-instruct
HF_TOKEN=

# ------------------------------------------------------------------
# Embedding / RAG tuning
# ------------------------------------------------------------------
RAG_TABLE_NAME=agora_rag_embeddings
PLATON_DOCS_VECTOR_TABLE=platon_docs_fr_chunks
PLATON_DOCS_QA_ENABLED=true

# ------------------------------------------------------------------
# Generation
# ------------------------------------------------------------------

LLM_PROVIDERS_FILE=resources/llm_providers.json
GROQ_API_KEY=
RAGUSTAVE_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=

